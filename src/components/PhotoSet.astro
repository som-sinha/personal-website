---
import type { PhotoSet } from "../lib/gallery";
import { monthYear } from "../lib/date";

interface Props {
  set: PhotoSet;
}

const { set } = Astro.props;
const { title, date, description, images } = set.data;
---

<section class="set">
  <div class="set-meta">
    <h2>{title}</h2>
    <time datetime={date.toISOString()}>{monthYear.format(date)}</time>
    <p>{description}</p>
  </div>
  <div class="grid">
    {
      images.map((src, i) => (
        <button
          class="tile"
          type="button"
          data-lightbox={src}
          data-caption={`${title} — ${i + 1}`}
        >
          <img src={src} alt={`${title} — ${i + 1}`} loading="lazy" />
        </button>
      ))
    }
  </div>
</section>

<style>
  .set {
    margin-top: 2.5rem;
  }

  .set-meta h2 {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: 1.25rem;
  }

  .set-meta time {
    display: block;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }

  .set-meta p {
    margin-top: 0.4rem;
  }

  .grid {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.5rem;
  }

  .tile {
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 2px;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .tile:hover img {
    transform: scale(1.04);
  }
</style>
