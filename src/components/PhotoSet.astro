---
import type { PhotoSet } from "../lib/gallery";
import { monthYear } from "../lib/date";

interface Props {
  set: PhotoSet;
}

const { set } = Astro.props;
const { title, date, description, images } = set.data;
---

<section class="set">
  <div class="set-meta">
    <h2>{title}</h2>
    <time datetime={date.toISOString()}>{monthYear.format(date)}</time>
    <p>{description}</p>
  </div>
  <div class="grid">
    {
      images.map((src, i) => (
        <button
          class="tile"
          type="button"
          data-lightbox={src}
          data-caption={`${title} — ${i + 1}`}
        >
          <img src={src} alt={`${title} — ${i + 1}`} loading="lazy" />
        </button>
      ))
    }
  </div>
</section>

<style>
  /* Theme vars (--photo-*) inherit from the .photo-theme wrapper. */
  .set {
    margin-top: 1.75rem;
  }

  .set:first-child {
    margin-top: 0;
  }

  .set-meta {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }

  .set-meta h2 {
    font-family:
      -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue",
      sans-serif;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: 1.05rem;
    color: var(--photo-fg);
  }

  .set-meta time {
    color: var(--photo-muted);
    font-size: 0.8rem;
  }

  .set-meta p {
    flex-basis: 100%;
    color: var(--photo-muted);
    font-size: 0.85rem;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 3px;
  }

  .tile {
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.15s ease,
      filter 0.15s ease;
  }

  .tile:hover img {
    transform: scale(1.05);
    filter: brightness(1.05);
  }

  .tile:focus-visible {
    outline: 3px solid var(--photo-accent);
    outline-offset: 1px;
  }
</style>
