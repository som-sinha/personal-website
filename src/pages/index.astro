---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredProject, primaryHref } from "../lib/projects";

const featured = await featuredProject();
const featuredHref = featured
  ? (primaryHref(featured) ?? "/projects")
  : "/projects";
---

<BaseLayout title="Som Sinha">
  <section class="about">
    <h1>Hi, I'm Som</h1>
    <p>
      Placeholder bio. A few lines about who I am, what I care about, and what
      you'll find around here — the Notebook, the Gallery, my Projects, and my
      Resume.
    </p>
  </section>

  <section class="currently">
    <h2>Currently working on:</h2>
    <p>
      {
        featured ? (
          <>
            <a href={featuredHref}>{featured.data.title}</a> —{" "}
            {featured.data.description}
          </>
        ) : (
          <a href="/projects">See my projects</a>
        )
      }
    </p>
  </section>

  <section class="contact">
    <h2>Contact</h2>
    <ul>
      <li><a href="mailto:hello@example.com">Email</a></li>
      <li><a href="https://github.com/">GitHub</a></li>
      <li><a href="https://www.linkedin.com/">LinkedIn</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  section {
    margin-block: 2.5rem;
  }

  section:first-of-type {
    margin-top: 0;
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
  }

  .contact ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
    flex-wrap: wrap;
  }
</style>
