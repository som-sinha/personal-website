---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import { allPosts } from "../lib/notebook";

const posts = await allPosts();
---

<BaseLayout title="Notebook — Som Sinha">
  <h1>Notebook</h1>

  {
    posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .posts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }
</style>
