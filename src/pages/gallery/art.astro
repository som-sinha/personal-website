---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/Lightbox.astro";

const pieces = (await getCollection("art"))
  .filter((piece) => !piece.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
});
---

<BaseLayout title="Art — Som Sinha">
  <div class="art-theme">
    <header class="head">
      <h1>Art</h1>
      <p><a href="/gallery">← Gallery</a></p>
    </header>

    {
      pieces.length === 0 ? (
        <p>No pieces yet.</p>
      ) : (
        <div class="wall">
          {pieces.map((piece) => (
            <figure class="piece">
              <div class="frame">
                {piece.data.images.map((src, i) => (
                  <button
                    class="canvas"
                    type="button"
                    data-lightbox={src}
                    data-caption={piece.data.title}
                  >
                    <img
                      src={src}
                      alt={`${piece.data.title} — ${i + 1}`}
                      loading="lazy"
                    />
                  </button>
                ))}
              </div>
              <figcaption>
                <h2>{piece.data.title}</h2>
                <time datetime={piece.data.date.toISOString()}>
                  {dateFmt.format(piece.data.date)}
                </time>
                <p>{piece.data.description}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </div>

  <Lightbox />
</BaseLayout>

<style>
  /* Scoped artsy/rustic theme: paper/canvas texture, warm palette, serif */
  .art-theme {
    --paper: #f4ecd8;
    --ink: #3b2f22;
    --ink-muted: #7a6a53;
    --frame: #b98b46;
    background: var(--paper);
    color: var(--ink);
    padding: 1.5rem;
    border-radius: 4px;
    background-image:
      radial-gradient(rgba(160, 130, 80, 0.08) 1px, transparent 1px),
      radial-gradient(rgba(160, 130, 80, 0.06) 1px, transparent 1px);
    background-size:
      12px 12px,
      24px 24px;
    background-position:
      0 0,
      6px 6px;
  }

  .art-theme a {
    color: var(--frame);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .head h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
  }

  .wall {
    margin-top: 2rem;
    display: grid;
    gap: 2.5rem;
  }

  .piece {
    margin: 0;
  }

  .frame {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    padding: 0.75rem;
    background: #fff;
    border: 10px solid var(--frame);
    border-radius: 2px;
    box-shadow: 0 6px 18px rgba(59, 47, 34, 0.25);
  }

  .canvas {
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .canvas img {
    width: 100%;
  }

  figcaption {
    margin-top: 1rem;
    text-align: center;
  }

  figcaption h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-size: 1.4rem;
    color: var(--ink);
  }

  figcaption time {
    display: block;
    color: var(--ink-muted);
    font-size: 0.85rem;
    margin-top: 0.2rem;
  }

  figcaption p {
    margin-top: 0.5rem;
    color: var(--ink-muted);
  }
</style>
