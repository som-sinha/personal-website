---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import { gallerySections } from "../lib/gallery";

const sections = await gallerySections();
---

<BaseLayout title="Gallery — Som Sinha">
  <h1>Gallery</h1>
  <p class="lede">Three rooms, three moods.</p>

  <ul class="sections">
    {
      sections.map((section) => (
        <Card href={section.href}>
          <h2 class="card-title">{section.title}</h2>
          <p>{section.description}</p>
        </Card>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .lede {
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .sections {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .sections :global(p) {
    margin-top: 0.5rem;
  }
</style>
