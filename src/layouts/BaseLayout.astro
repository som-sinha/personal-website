---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Som Sinha's little nook on the internet: software projects, photos, art, performances and the occasional ramble.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2c6e49" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Link previews when the site is shared (Slack, iMessage, LinkedIn...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Som Sinha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne+Mono&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
  </body>
</html>
