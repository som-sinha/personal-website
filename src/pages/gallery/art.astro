---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/Lightbox.astro";
import ArtPieceCard from "../../components/ArtPieceCard.astro";
import { artPieces } from "../../lib/gallery";

const pieces = await artPieces();
---

<BaseLayout title="Art — Som Sinha">
  <div class="art-theme">
    <header class="head">
      <h1>Art</h1>
      <p><a href="/gallery">← Gallery</a></p>
    </header>

    {
      pieces.length === 0 ? (
        <p>No pieces yet.</p>
      ) : (
        <div class="wall">
          {pieces.map((piece) => (
            <ArtPieceCard piece={piece} />
          ))}
        </div>
      )
    }
  </div>

  <Lightbox />
</BaseLayout>

<style>
  /* Scoped artsy/rustic theme: paper/canvas texture, warm palette, serif */
  .art-theme {
    --paper: #f4ecd8;
    --ink: #3b2f22;
    --ink-muted: #7a6a53;
    --frame: #b98b46;
    background: var(--paper);
    color: var(--ink);
    padding: 1.5rem;
    border-radius: 4px;
    background-image:
      radial-gradient(rgba(160, 130, 80, 0.08) 1px, transparent 1px),
      radial-gradient(rgba(160, 130, 80, 0.06) 1px, transparent 1px);
    background-size:
      12px 12px,
      24px 24px;
    background-position:
      0 0,
      6px 6px;
  }

  .art-theme a {
    color: var(--frame);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .head h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
  }

  .wall {
    margin-top: 2rem;
    display: grid;
    gap: 2.5rem;
  }
</style>
