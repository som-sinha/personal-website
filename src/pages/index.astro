---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Som Sinha">
  <section class="hero">
    <h1>Hi, I'm Som.</h1>
    <p class="lede">
      Nerdy tinkerer at heart, software developer at work — I write, make
      pictures, and put things on stage.
    </p>
  </section>

  <section class="about">
    <h2>About Me</h2>
    <p>
      Placeholder bio. A few lines about who I am, what I care about, and what
      you'll find around here — the Notebook, the Gallery, my Projects, and my
      Resume.
    </p>
  </section>

  <section class="currently">
    <h2>Currently working on:</h2>
    <p>
      <a href="/projects">A featured project</a> — placeholder link to the currently-featured
      project (wired up in T6).
    </p>
  </section>

  <section class="contact">
    <h2>Contact</h2>
    <ul>
      <li><a href="mailto:hello@example.com">Email</a></li>
      <li><a href="https://github.com/">GitHub</a></li>
      <li><a href="https://www.linkedin.com/">LinkedIn</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  section {
    margin-block: 2.5rem;
  }

  .hero h1 {
    font-family: var(--font-logo);
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .lede {
    color: var(--text-muted);
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
  }

  .contact ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
    flex-wrap: wrap;
  }
</style>
