---
import { type Performance, youtubeThumb, youtubeWatch } from "../lib/gallery";

interface Props {
  clip: Performance;
}

const { clip } = Astro.props;
const { title, youtubeId } = clip.data;
---

<a class="card" href={youtubeWatch(youtubeId)} target="_blank" rel="noopener">
  <img src={youtubeThumb(youtubeId)} alt={title} loading="lazy" />
  <span class="card-title">{title}</span>
</a>

<style>
  /* --scard inherits from the .stream-theme wrapper. */
  .card {
    scroll-snap-align: start;
    background: var(--scard);
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .card:hover {
    transform: scale(1.03);
  }

  .card img {
    width: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 9;
  }

  .card-title {
    display: block;
    padding: 0.6rem 0.75rem;
    font-size: 0.9rem;
  }
</style>
