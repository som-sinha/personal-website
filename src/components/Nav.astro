---
const items = [
  { href: "/notebook", label: "Notebook", emoji: "📝" },
  { href: "/gallery", label: "Gallery", emoji: "🖼️" },
  { href: "/projects", label: "Projects", emoji: "🛠️" },
  { href: "/resume", label: "Resume", emoji: "💼" },
];
---

<nav>
  <a href="/" class="logo">Som Sinha</a>
  <p class="tagline">
    <span class="tagline-short">Nerdy Tinkerer at Heart, </span><span
      class="tagline-rest">Software Developer at Work</span
    >
  </p>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href}>
            <span class="emoji" aria-hidden="true">
              {item.emoji}
            </span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  nav {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0 1rem;
  }

  .logo,
  .logo:hover {
    font-family: var(--font-logo);
    font-size: 2.5rem;
    color: var(--text);
    text-decoration: none;
  }

  .tagline {
    font-size: 1rem;
    color: var(--text-muted);
  }

  nav ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  nav ul a {
    font-family: var(--font-logo);
    text-decoration: none;
    font-size: 1.35rem;
  }

  nav ul .emoji {
    margin-right: 0.35rem;
  }

  @media (max-width: 480px) {
    .tagline-rest {
      display: block;
    }
  }
</style>
