---
import type { ArtPiece } from "../lib/gallery";
import { monthYear } from "../lib/date";

interface Props {
  piece: ArtPiece;
}

const { piece } = Astro.props;
const { title, date, description, images } = piece.data;
---

<figure class="piece">
  <div class="frame">
    {
      images.map((src, i) => (
        <button
          class="canvas"
          type="button"
          data-lightbox={src}
          data-caption={title}
        >
          <img src={src} alt={`${title} — ${i + 1}`} loading="lazy" />
        </button>
      ))
    }
  </div>
  <figcaption>
    <h2>{title}</h2>
    <time datetime={date.toISOString()}>{monthYear.format(date)}</time>
    <p>{description}</p>
  </figcaption>
</figure>

<style>
  /* Colour vars (--frame/--ink/--ink-muted) inherit from the .art-theme wrapper. */
  .piece {
    margin: 0;
  }

  .frame {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    padding: 0.75rem;
    background: #fff;
    border: 10px solid var(--frame);
    border-radius: 2px;
    box-shadow: 0 6px 18px rgba(59, 47, 34, 0.25);
  }

  .canvas {
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .canvas img {
    width: 100%;
  }

  figcaption {
    margin-top: 1rem;
    text-align: center;
  }

  figcaption h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-size: 1.4rem;
    color: var(--ink);
  }

  figcaption time {
    display: block;
    color: var(--ink-muted);
    font-size: 0.85rem;
    margin-top: 0.2rem;
  }

  figcaption p {
    margin-top: 0.5rem;
    color: var(--ink-muted);
  }
</style>
