---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/Lightbox.astro";
import PhotoSet from "../../components/PhotoSet.astro";
import { photographySets } from "../../lib/gallery";

const sets = await photographySets();
---

<BaseLayout title="Photography — Som Sinha">
  <div class="photo-theme">
    <header class="head">
      <h1>Photography</h1>
      <p><a href="/gallery">← Gallery</a></p>
    </header>

    {
      sets.length === 0 ? (
        <p>No photo sets yet.</p>
      ) : (
        sets.map((set) => <PhotoSet set={set} />)
      )
    }
  </div>

  <Lightbox />
</BaseLayout>

<style>
  /* Scoped clean/digital theme */
  .photo-theme {
    --photo-bg: #0f1115;
    --photo-fg: #e7e9ee;
    --photo-muted: #9aa0ac;
    --photo-line: #262a33;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
