---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredProject, primaryHref } from "../lib/projects";

const featured = await featuredProject();
const featuredHref = featured
  ? (primaryHref(featured) ?? "/projects")
  : "/projects";
---

<BaseLayout title="Som Sinha">
  <section class="about">
    <h1>Hi, I'm Som</h1>
    <p>
      Welcome to my little nook on the internet. Here you'll find a showcase of
      my projects, photos I've clicked or art I've made, my performances as an
      amateur actor, and sometimes my ramblings in the Notebook.
    </p>
  </section>

  <section class="currently">
    <h2>Currently working on:</h2>
    <p>
      {
        featured ? (
          <>
            <a href={featuredHref}>{featured.data.title}</a> —{" "}
            {featured.data.description}
          </>
        ) : (
          <a href="/projects">See my projects</a>
        )
      }
    </p>
  </section>

  <section class="contact">
    <h2>Contact</h2>
    <ul>
      <li>
        <!-- Address is assembled in the browser so it never sits in the HTML
             for scrapers to harvest. -->
        <a class="email" data-user="mailsomsinha" data-domain="gmail.com"
          >Email</a
        >
      </li>
      <li><a href="https://github.com/som-sinha">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/som-sinha">LinkedIn</a></li>
    </ul>
  </section>
</BaseLayout>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>(".email")) {
    link.href = `mailto:${link.dataset.user}@${link.dataset.domain}`;
  }
</script>

<style>
  section {
    margin-block: 2.5rem;
  }

  section:first-of-type {
    margin-top: 0;
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
  }

  .contact ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
    flex-wrap: wrap;
  }
</style>
