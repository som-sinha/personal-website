---
import { type Project, hasBody, primaryHref } from "../lib/projects";
import Card from "./Card.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detail = hasBody(project);
const href = primaryHref(project);
const { title, description, tech, links } = project.data;
---

<Card>
  <h2>
    {
      href ? (
        <a class="card-title" href={href} target={detail ? undefined : "_blank"}>
          {title}
        </a>
      ) : (
        <span class="card-title">{title}</span>
      )
    }
  </h2>
  <p class="desc">{description}</p>
  {
    tech.length > 0 && (
      <ul class="tech">
        {tech.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )
  }
  <ul class="links">
    {
      detail && (
        <li>
          <a href={`/projects/${project.id}`}>Details</a>
        </li>
      )
    }
    {
      links.github && (
        <li>
          <a href={links.github} target="_blank">
            GitHub
          </a>
        </li>
      )
    }
    {
      links.demo && (
        <li>
          <a href={links.demo} target="_blank">
            Demo
          </a>
        </li>
      )
    }
  </ul>
</Card>

<style>
  h2 {
    margin: 0;
  }

  .desc {
    margin-top: 0.5rem;
  }

  .tech {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .tech li {
    font-size: 0.8rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin-top: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }
</style>
