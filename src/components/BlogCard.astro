---
import type { Post } from "../lib/notebook";
import { longDate } from "../lib/date";
import Card from "./Card.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<Card>
  <a class="card-title" href={`/notebook/${post.id}`}>{post.data.title}</a>
  <time datetime={post.data.date.toISOString()}>
    {longDate.format(post.data.date)}
  </time>
  <p>{post.data.description}</p>
</Card>

<style>
  time {
    display: block;
    color: var(--turf-green);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  p {
    margin-top: 0.5rem;
  }
</style>
